# ── Çalışma ortamı ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Nginx gibi bir ters proxy arkasındaysa 1 yapın (gerçek istemci IP'si için).
TRUST_PROXY=0

# ── Veritabanı ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/portfolio
DATABASE_POOL_MAX=10

# ── JWT ─────────────────────────────────────────────────────────────────────
# İkisi de EN AZ 32 karakter ve birbirinden FARKLI olmalı.
# Üretmek için:  openssl rand -hex 32
JWT_ACCESS_SECRET=change_me_with_openssl_rand_hex_32_chars_min
JWT_REFRESH_SECRET=change_me_too_different_secret_32_chars_min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── CORS ────────────────────────────────────────────────────────────────────
# Virgülle ayrılmış allow-list. Production'da gerçek alan adınızı yazın.
CORS_ORIGINS=http://localhost:3000

# ── Rate limiting ───────────────────────────────────────────────────────────
# THROTTLE_TTL saniye içinde en fazla THROTTLE_LIMIT istek (genel sınır).
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# ── Diğer ───────────────────────────────────────────────────────────────────
# Production'da 0 yaparak /docs ucunu kapatabilirsiniz.
SWAGGER_ENABLED=1
LOG_LEVEL=info

# ── Seed (yalnızca ilk admin hesabı için) ───────────────────────────────────
ADMIN_EMAIL=admin@burakgemici.com.tr
ADMIN_PASSWORD=ChangeMe_In_Production!
ADMIN_NAME=Burak Gemici
