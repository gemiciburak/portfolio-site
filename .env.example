# Kök dizin: docker-compose'un kullandığı altyapı değişkenleri.
# Uygulama ayarları (JWT sırları vb.) backend/.env dosyasındadır.

POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=portfolio

# Sitenin tarayıcıdaki adresi — API'nin CORS allow-list'i bundan türer.
# Production'da Vercel'deki alan adı:
PUBLIC_ORIGIN=https://www.burakgemici.com.tr

# Geliştirme (docker-compose.yml) için:
# PUBLIC_ORIGIN=http://localhost:3000
# CORS_ORIGINS=http://localhost:3000
# NEXT_PUBLIC_API_URL=http://localhost:4000/api
