# Kök dizin: docker-compose'un kullandığı altyapı değişkenleri.
# Uygulama ayarları (JWT sırları vb.) backend/.env dosyasındadır.

POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=portfolio

# Production (docker-compose.prod.yml): sitenin genel adresi.
# Hem CORS allow-list'i hem de tarayıcıya gömülen API adresi buradan türer.
PUBLIC_ORIGIN=https://www.burakgemici.com.tr

# Geliştirme (docker-compose.yml) için:
# CORS_ORIGINS=http://localhost:3000
# NEXT_PUBLIC_API_URL=http://localhost:4000/api
