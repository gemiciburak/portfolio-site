# Sunucu tarafı (SSR/ISR) istekleri için API adresi. CORS'a tabi değildir.
#   lokal          : http://localhost:4000/api
#   Docker Compose : http://api:4000/api
#   production     : https://api.burakgemici.com.tr/api
API_URL=http://localhost:4000/api

# Tarayıcıdan yapılan istekler (iletişim formu, admin panel) için.
# Build anında paketlenir — değiştirince yeniden deploy gerekir.
# Bu origin, API'nin CORS allow-list'inde bulunmalı.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
