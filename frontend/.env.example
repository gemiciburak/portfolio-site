# Sunucu tarafı (SSR/ISR) istekleri için API adresi.
# Docker Compose içinde servis adına bakar: http://api:4000/api
API_URL=http://localhost:4000/api

# Tarayıcıdan yapılan istekler (iletişim formu, admin panel) için.
# Build anında paketlenir — production'da genel alan adınızı yazın.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
